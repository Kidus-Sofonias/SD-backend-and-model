# =============================================================================
# Safe Driving Backend — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- REQUIRED: Authentication & Security -------------------------------------
# Generate a strong random key for JWT signing.
# Run: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-strong-random-key

# Admin user password (the default admin user is created on first startup).
ADMIN_PASSWORD=change-me-to-a-strong-password

# --- OPTIONAL: Environment ---------------------------------------------------
# One of: local, dev, staging, production
APP_ENV=local

# --- OPTIONAL: Database ------------------------------------------------------
# Default: SQLite file-based database
# DATABASE_URL=sqlite:///./sdbackend.db
# For PostgreSQL (deployed):
# DATABASE_URL=postgresql://user:password@host:5432/safedriving

# --- OPTIONAL: Application ---------------------------------------------------
APP_NAME=safe-driving-api
APP_VERSION=0.1.0
DEBUG=false
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# CORS origins (comma-separated list of allowed origins)
CORS_ORIGINS_RAW=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006,http://localhost:3000,http://127.0.0.1:3000

# Admin email (default admin user)
ADMIN_EMAIL=admin@sdb.com
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- OPTIONAL: ML / Auto-Retrain ---------------------------------------------
AUTO_RETRAIN_ENABLED=false
AUTO_RETRAIN_TRIP_INTERVAL=100
AUTO_RETRAIN_SKIP_TESTS=true

# --- OPTIONAL: Route Snapping (OSRM) -----------------------------------------
ROUTE_SNAP_ENABLED=true
ROUTE_SNAP_BASE_URL=https://router.project-osrm.org
